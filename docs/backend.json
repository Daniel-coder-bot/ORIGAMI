
{
  "entities": {
    "Material": {
      "title": "Material",
      "description": "Representa un artículo o material en el inventario.",
      "type": "object",
      "properties": {
        "codigo": { "type": "string", "description": "Código único de identificación del material." },
        "nombre": { "type": "string" },
        "descripcion": { "type": "string" },
        "unidad": { "type": "string" },
        "categoria": { "type": "string" },
        "stockActual": { "type": "number" },
        "stockMinimo": { "type": "number" }
      },
      "required": ["codigo", "nombre", "unidad", "stockActual"]
    },
    "Movimiento": {
      "title": "Movimiento",
      "description": "Registro de entrada o salida de un material.",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "materialNombre": { "type": "string" },
        "trabajadorId": { "type": "string" },
        "trabajadorNombre": { "type": "string" },
        "tipo": { "type": "string" },
        "cantidad": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" },
        "notas": { "type": "string" }
      },
      "required": ["materialId", "tipo", "cantidad", "fecha"]
    },
    "Trabajador": {
      "title": "Trabajador",
      "description": "Perfil de un empleado del sistema.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "correo": { "type": "string", "format": "email" },
        "rol": { "type": "string" },
        "telefono": { "type": "string" },
        "activo": { "type": "boolean" },
        "fechaRegistro": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "correo", "rol"]
    },
    "Categoria": {
      "title": "Categoría",
      "description": "Categoría de clasificación para materiales.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" }
      },
      "required": ["nombre"]
    },
    "Rol": {
      "title": "Rol",
      "description": "Cargo o rol para los trabajadores.",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" }
      },
      "required": ["nombre"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/materiales/{materialId}": {
      "schema": "#/backend/entities/Material",
      "description": "Colección de materiales de inventario."
    },
    "/movimientos/{movimientoId}": {
      "schema": "#/backend/entities/Movimiento",
      "description": "Registro histórico de movimientos."
    },
    "/trabajadores/{trabajadorId}": {
      "schema": "#/backend/entities/Trabajador",
      "description": "Directorio de personal."
    },
    "/categorias/{categoriaId}": {
      "schema": "#/backend/entities/Categoria",
      "description": "Lista maestra de categorías de inventario."
    },
    "/roles/{rolId}": {
      "schema": "#/backend/entities/Rol",
      "description": "Lista maestra de roles de personal."
    }
  }
}
