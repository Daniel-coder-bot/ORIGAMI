
{
  "entities": {
    "Rol": {
      "title": "Rol",
      "type": "object",
      "description": "Define los roles que los trabajadores pueden tener dentro del sistema.",
      "properties": {
        "nombre": { "type": "string" }
      },
      "required": ["nombre"]
    },
    "Categoria": {
      "title": "Categoria",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" }
      },
      "required": ["nombre"]
    },
    "Trabajador": {
      "title": "Trabajador",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "correo": { "type": "string", "format": "email" },
        "rol": { "type": "string" },
        "activo": { "type": "boolean" },
        "telefono": { "type": "string" },
        "password": { "type": "string", "description": "Solo para Administradores y Gestores" }
      },
      "required": ["nombre", "correo", "rol"]
    },
    "Usuario": {
      "title": "Usuario",
      "type": "object",
      "description": "Credenciales para acceso administrativo",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "nombre": { "type": "string" },
        "role": { "type": "string", "enum": ["Administrador", "Gestor de Proyecto"] }
      },
      "required": ["email", "password", "role"]
    },
    "Articulo": {
      "title": "Articulo",
      "type": "object",
      "properties": {
        "codigo": { "type": "string" },
        "nombre": { "type": "string" },
        "categoria": { "type": "string" },
        "descripcion": { "type": "string" },
        "unidad": { "type": "string" },
        "stockActual": { "type": "number" },
        "stockMinimo": { "type": "number" }
      },
      "required": ["codigo", "nombre", "categoria", "stockActual"]
    },
    "MovimientoStock": {
      "title": "MovimientoStock",
      "type": "object",
      "properties": {
        "articuloId": { "type": "string" },
        "trabajadorId": { "type": "string" },
        "tipo": { "type": "string", "enum": ["entrada", "salida"] },
        "cantidad": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" }
      },
      "required": ["articuloId", "trabajadorId", "tipo", "cantidad", "fecha"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      { "path": "/roles/{rolId}", "definition": { "entityName": "Rol", "description": "Roles de usuario" } },
      { "path": "/categorias/{catId}", "definition": { "entityName": "Categoria", "description": "Categorías de productos" } },
      { "path": "/trabajadores/{trabajadorId}", "definition": { "entityName": "Trabajador", "description": "Perfiles de trabajadores" } },
      { "path": "/usuarios/{userId}", "definition": { "entityName": "Usuario", "description": "Usuarios con acceso administrativo" } },
      { "path": "/articulos/{articuloId}", "definition": { "entityName": "Articulo", "description": "Inventario de artículos" } },
      { "path": "/movimientosStock/{movId}", "definition": { "entityName": "MovimientoStock", "description": "Historial de movimientos" } }
    ]
  }
}
